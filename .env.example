# ==============================================================================
# FloatChat Environment Variables Configuration File
# Copy this file to .env and configure based on your environment
# ==============================================================================

# Database Settings
# - SQLite (Local Fallback & Demo Mode): sqlite:///./floatchat.db
# - PostgreSQL (Production Architecture): postgresql://floatuser:floatpassword@localhost:5432/floatchat
DATABASE_URL=sqlite:///./floatchat.db

# LLM & OpenAI Compatible Settings
# - If left blank, FloatChat will run in high-fidelity "Demo Mode" using 
#   local dynamic SQL translation templates and explanations.
# - If configured, FloatChat will run in "Production Mode" utilizing OpenAI 
#   or another OpenAI-compatible base URL (like Ollama, LocalAI, vLLM).
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
