FROM node:18-alpine

WORKDIR /app

# Copy package configurations
COPY package.json .

# Install dependencies
RUN npm install

# Copy application files
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Run Vite in host mode so that docker ports bind correctly
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
